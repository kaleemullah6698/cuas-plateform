<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.4.1</version>
    <relativePath/>
  </parent>

  <groupId>pk.nust.cuas</groupId>
  <artifactId>platform-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>platform-parent</name>
  <description>Dependency and plugin management for all CUAS platform services</description>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!--
      Per-module line-coverage floor for the `coverage-gate` profile (SR-7).

      Measured, not chosen. At the time it was set the seventeen modules ran from 40.7%
      (alert-service) to 90.2% (api-gateway), with a median near 76%; `contracts` is excluded in its
      own POM because its ~29% is a statement about generated Protobuf, not about testing. 0.40 sits
      just under the real floor, so the gate passes today and any module that drops below the worst
      current module fails CI.

      This is deliberately not ARCHITECTURE.md §8.4.1's aspirational 80%: five modules would fail it
      immediately, and a gate nobody can pass is a gate somebody disables. It is a ratchet — raise it
      as coverage improves, and lowering it should require saying why in the commit message.
    -->
    <coverage.line.minimum>0.40</coverage.line.minimum>

    <grpc.version>1.69.0</grpc.version>
    <!--
      Spring Cloud 2024.0.x is the release train paired with Spring Boot 3.4.x. Only the
      servlet-stack gateway (spring-cloud-starter-gateway-mvc) is used: platform-commons builds on
      jakarta.servlet, so a reactive gateway would fork every shared cross-cutting concern.
    -->
    <spring-cloud.version>2024.0.0</spring-cloud.version>
    <protobuf.version>4.29.2</protobuf.version>
    <springdoc.version>2.7.0</springdoc.version>
    <resilience4j.version>2.2.0</resilience4j.version>
    <!--
      1.21.3+ is required: its bundled docker-java negotiates a Docker Engine API version that
      Engine 29 still accepts. Older Testcontainers releases request an API below the engine's
      minimum (1.40) and every connection strategy fails with HTTP 400 on /info.
    -->
    <testcontainers.version>1.21.3</testcontainers.version>
    <mapstruct.version>1.6.3</mapstruct.version>
    <jacoco.version>0.8.12</jacoco.version>
    <logstash-encoder.version>8.0</logstash-encoder.version>
    <javax-annotation.version>1.3.2</javax-annotation.version>
    <!-- Argon2id provider (section 7.3) and RS256/JWKS support (section 7.3). -->
    <bouncycastle.version>1.79</bouncycastle.version>
    <nimbus-jose-jwt.version>9.47</nimbus-jose-jwt.version>
    <build-helper-plugin.version>3.6.0</build-helper-plugin.version>
    <exec-plugin.version>3.5.0</exec-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-bom</artifactId>
        <version>${grpc.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!--
        Standardise on protoc v29.2 / protobuf-java 4.29.2 across the platform. This overrides
        the older protobuf-java version managed by the Spring Boot BOM, so that hand-written code
        and the buf-generated bindings (produced by the pinned v29.2 plugins) share one runtime.
      -->
      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java</artifactId>
        <version>${protobuf.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java-util</artifactId>
        <version>${protobuf.version}</version>
      </dependency>
      <dependency>
        <groupId>javax.annotation</groupId>
        <artifactId>javax.annotation-api</artifactId>
        <version>${javax-annotation.version}</version>
      </dependency>
      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcprov-jdk18on</artifactId>
        <version>${bouncycastle.version}</version>
      </dependency>
      <dependency>
        <groupId>com.nimbusds</groupId>
        <artifactId>nimbus-jose-jwt</artifactId>
        <version>${nimbus-jose-jwt.version}</version>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.resilience4j</groupId>
        <artifactId>resilience4j-spring-boot3</artifactId>
        <version>${resilience4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.mapstruct</groupId>
        <artifactId>mapstruct</artifactId>
        <version>${mapstruct.version}</version>
      </dependency>
      <dependency>
        <groupId>net.logstash.logback</groupId>
        <artifactId>logstash-logback-encoder</artifactId>
        <version>${logstash-encoder.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <systemPropertyVariables>
              <!--
                Pin the Docker Engine API version used by Testcontainers.

                docker-java falls back to API 1.32, and Docker Engine 29 rejects anything below
                its minimum of 1.40 with an opaque HTTP 400 — every connection strategy then
                fails with "Could not find a valid Docker environment". docker-java reads this
                as the system property `api.version` (the DOCKER_API_VERSION environment
                variable is honoured by the docker CLI, not by docker-java). 1.41 is the highest
                version Docker 20.10 supports, so this stays compatible with older engines while
                satisfying current ones.
              -->
              <api.version>1.41</api.version>
            </systemPropertyVariables>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!--
        Coverage measurement, inherited by every module (SECURITY-REVIEW finding SR-7).

        The version was declared in pluginManagement from the start but the plugin was never bound to
        a phase, so no execution existed and nothing was ever measured. ARCHITECTURE.md section 8.4.1
        specifies a coverage gate in CI; a gate needs a number, and a number needs an agent.

        `prepare-agent` sets the argLine surefire runs with, and `report` writes
        target/site/jacoco/jacoco.xml per module. The `check` goal is deliberately NOT bound here —
        see the `coverage-gate` profile below.
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      The coverage gate, opt-in via `-Pcoverage-gate`.

      Kept behind a profile rather than bound to every build for one reason: the threshold below is
      the measured floor of this codebase, not section 8.4.1's aspirational 80%, and a gate that
      fails an ordinary local `mvn verify` would be turned off within a day. CI runs it explicitly so
      the number can only move upwards — a change that drops coverage below the floor fails there.

      The floor is set from an actual measurement rather than chosen: raising it is a deliberate act,
      and lowering it should require explaining why in a commit message.
    -->
    <profile>
      <id>coverage-gate</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>check</id>
                <phase>verify</phase>
                <goals>
                  <goal>check</goal>
                </goals>
                <configuration>
                  <rules>
                    <rule>
                      <element>BUNDLE</element>
                      <limits>
                        <limit>
                          <counter>LINE</counter>
                          <value>COVEREDRATIO</value>
                          <minimum>${coverage.line.minimum}</minimum>
                        </limit>
                      </limits>
                    </rule>
                  </rules>
                  <!--
                    Modules with nothing meaningful to cover: `contracts` is generated Protobuf plus
                    serde round-trips, and `sensor-simulator` is a development adapter. Neither
                    should be able to drag the platform's floor up or down.
                  -->
                  <haltOnFailure>true</haltOnFailure>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
