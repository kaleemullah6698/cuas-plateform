<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.4.1</version>
    <relativePath/>
  </parent>

  <groupId>pk.nust.cuas</groupId>
  <artifactId>platform-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>platform-parent</name>
  <description>Dependency and plugin management for all CUAS platform services</description>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <grpc.version>1.69.0</grpc.version>
    <protobuf.version>4.29.2</protobuf.version>
    <springdoc.version>2.7.0</springdoc.version>
    <resilience4j.version>2.2.0</resilience4j.version>
    <!--
      1.21.3+ is required: its bundled docker-java negotiates a Docker Engine API version that
      Engine 29 still accepts. Older Testcontainers releases request an API below the engine's
      minimum (1.40) and every connection strategy fails with HTTP 400 on /info.
    -->
    <testcontainers.version>1.21.3</testcontainers.version>
    <mapstruct.version>1.6.3</mapstruct.version>
    <jacoco.version>0.8.12</jacoco.version>
    <logstash-encoder.version>8.0</logstash-encoder.version>
    <javax-annotation.version>1.3.2</javax-annotation.version>
    <build-helper-plugin.version>3.6.0</build-helper-plugin.version>
    <exec-plugin.version>3.5.0</exec-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-bom</artifactId>
        <version>${grpc.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!--
        Standardise on protoc v29.2 / protobuf-java 4.29.2 across the platform. This overrides
        the older protobuf-java version managed by the Spring Boot BOM, so that hand-written code
        and the buf-generated bindings (produced by the pinned v29.2 plugins) share one runtime.
      -->
      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java</artifactId>
        <version>${protobuf.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java-util</artifactId>
        <version>${protobuf.version}</version>
      </dependency>
      <dependency>
        <groupId>javax.annotation</groupId>
        <artifactId>javax.annotation-api</artifactId>
        <version>${javax-annotation.version}</version>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.resilience4j</groupId>
        <artifactId>resilience4j-spring-boot3</artifactId>
        <version>${resilience4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.mapstruct</groupId>
        <artifactId>mapstruct</artifactId>
        <version>${mapstruct.version}</version>
      </dependency>
      <dependency>
        <groupId>net.logstash.logback</groupId>
        <artifactId>logstash-logback-encoder</artifactId>
        <version>${logstash-encoder.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <systemPropertyVariables>
              <!--
                Pin the Docker Engine API version used by Testcontainers.

                docker-java falls back to API 1.32, and Docker Engine 29 rejects anything below
                its minimum of 1.40 with an opaque HTTP 400 — every connection strategy then
                fails with "Could not find a valid Docker environment". docker-java reads this
                as the system property `api.version` (the DOCKER_API_VERSION environment
                variable is honoured by the docker CLI, not by docker-java). 1.41 is the highest
                version Docker 20.10 supports, so this stays compatible with older engines while
                satisfying current ones.
              -->
              <api.version>1.41</api.version>
            </systemPropertyVariables>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
