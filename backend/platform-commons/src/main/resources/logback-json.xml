<?xml version="1.0" encoding="UTF-8"?>
<!--
  Structured JSON logging for platform services (ARCHITECTURE.md section 8.6).

  A service opts in from its own logback-spring.xml:

      <include resource="logback-json.xml"/>
      <root level="INFO"><appender-ref ref="JSON"/></root>

  Every line carries the correlation ID from the MDC, so logs across services join on a
  single request. Human-readable console logging remains the default for local development;
  this appender is intended for the containerised profiles where a log collector consumes JSON.
-->
<included>
  <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
      <includeMdcKeyName>correlationId</includeMdcKeyName>
      <fieldNames>
        <timestamp>timestamp</timestamp>
        <version>[ignore]</version>
        <levelValue>[ignore]</levelValue>
      </fieldNames>
      <customFields>{"platform":"cuas"}</customFields>
    </encoder>
  </appender>
</included>
