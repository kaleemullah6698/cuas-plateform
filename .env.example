# Copy to .env and fill in. Never commit .env.
# ARCHITECTURE.md section 7.7: no secret in source control, in a container
# image, or in a production environment variable.

# ── PostgreSQL ──
POSTGRES_USER=cuas
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Kafka ──
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SCHEMA_REGISTRY_URL=http://schema-registry:8081

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-locally

# ── Elasticsearch ──
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=

# ── MinIO ──
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ── AI provider mode: mock | grpc (ARCHITECTURE.md section 6.4) ──
# The two-track switch. Keep 'mock' until Track B models are trained.
AI_PROVIDER_MODE=mock

# ── Development scenario replay (section 8.2) ──
SCENARIO=single-intrusion

# ── Protected asset for CPA scoring (sections 4.1.5, 6.3.4) ──
# Section 4.1.12 gives protected-asset geometry to config-service; until it owns them, one is
# configured here and read through track-correlation's ProtectedAssetRegistry port.
#
# With no asset configured, four of the five scoring factors — proximity, closing velocity,
# trajectory intent, and the reliability they contribute to — are permanently unavailable, and every
# threat score rests on model confidence alone. The pipeline still runs; it just never demonstrates
# what it is for. The default is co-located with the simulator's replay origin.
PROTECTED_ASSET_ID=SITE-1
PROTECTED_ASSET_NAME=Primary Site
PROTECTED_ASSET_LAT=33.6844
PROTECTED_ASSET_LON=73.0479

# ── First-administrator bootstrap (M11) ──
# A fresh deployment has no user and no credential — RBAC reference data seeds itself from the
# Role/Permission enums, but nobody holds a role, and no endpoint creates one. Enable this for the
# first bring-up, sign in, create real accounts, then turn it off.
#
# auth-service refuses to start if this is enabled with no password: there is deliberately no
# default, because a built-in one would be a credential in source control and the first thing tried
# against any deployment of this platform. Minimum 12 characters (section 7.3).
#
# The bootstrap never overwrites an existing administrator, so leaving it enabled cannot reset the
# password — but turn it off anyway once real accounts exist.
CUAS_BOOTSTRAP_ADMIN_ENABLED=false
CUAS_BOOTSTRAP_ADMIN_USERNAME=admin
CUAS_BOOTSTRAP_ADMIN_EMAIL=admin@cuas.local
CUAS_BOOTSTRAP_ADMIN_PASSWORD=
