# Copy to .env and fill in. Never commit .env.
# ARCHITECTURE.md section 7.7: no secret in source control, in a container
# image, or in a production environment variable.

# ── PostgreSQL ──
POSTGRES_USER=cuas
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Kafka ──
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SCHEMA_REGISTRY_URL=http://schema-registry:8081

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-locally

# ── Elasticsearch ──
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=

# ── MinIO ──
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ── AI provider mode: mock | grpc (ARCHITECTURE.md section 6.4) ──
# The two-track switch. Keep 'mock' until Track B models are trained.
AI_PROVIDER_MODE=mock

# ── Development scenario replay (section 8.2) ──
SCENARIO=single-intrusion
